# AgentQuarantine environment. Copy to .env and fill in. Never commit .env.

# --- Storage (audit log + approval records) ---
# Neon Postgres connection string (Neon dashboard -> Connection details).
# Use the pooled connection string. sslmode=require is needed.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- Judgment scorer ---
# classifier = free public label classifier (no key). jev = key-based judgment model.
# Primary judgment provider: jev (TYPESAFE_API_KEY) | openai (OPENAI_API_KEY) | classifier (CLASSIFIER_KEY).
JUDGE_PROVIDER=jev
# Used only when the primary fails. Set to none to disable.
JUDGE_FALLBACK=openai
# OpenAI judge model and reasoning effort (none is fastest; same accuracy in tests).
# OPENAI_JUDGE_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=none
# Optional: override every provider time budget (ms).
# JUDGE_BUDGET_MS=1500
OPENAI_API_KEY=
# Only needed when JUDGE_PROVIDER=jev. Keep server-side.
TYPESAFE_API_KEY=
# Optional key for the free classifier's production tier.
CLASSIFIER_KEY=

# --- Agent harness ---
# Only if the harness needs a model provider key of its own.
# TRUEFORGE_SERVER_URL=http://localhost:8790