# AgentQuarantine environment. Copy to .env and fill in. Never commit .env.
# Real environment variables always win over this file. An empty value counts as "unset".

# --- Storage (audit log + approval records) ---
# Neon Postgres connection string (Neon dashboard -> Connection details).
# Use the pooled connection string. sslmode=require is needed.
# Leave empty (or set PERSIST_AUDIT=off) to run with the in-memory log only.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# PERSIST_AUDIT=off

# --- Judgment scorer (second opinion, raise-only) ---
# Primary provider: jev (TYPESAFE_API_KEY) | openai (OPENAI_API_KEY) | classifier (CLASSIFIER_KEY)
JUDGE_PROVIDER=jev
# Used only when the primary fails (error, timeout, bad response). Set to none to disable.
JUDGE_FALLBACK=openai
# OpenAI judge model and reasoning effort (none is fastest; same accuracy in tests).
# OPENAI_JUDGE_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=none
# Optional: override every provider's time budget (ms). Defaults: jev/classifier 1500, openai 3500.
# JUDGE_BUDGET_MS=1500
TYPESAFE_API_KEY=
OPENAI_API_KEY=
# classifier.dev: needs a funded workspace key; the free tier can return 403 proxy_requires_payment.
CLASSIFIER_KEY=

# --- LLM agents (attacker + defender) ---
AGENT_MODEL=gpt-6-luna
TOOL_SERVER_PORT=3007
# TOOL_SERVER_URL=http://localhost:3007

# How long an agent's checkout waits (over MCP) for the human Judge before saying it is still waiting. Keep under 240000.
# APPROVAL_WAIT_MS=120000

# --- Signed agents (tier 1) ---
# Shared HMAC secret used by the gateway to verify signatures and by agents/signed-agent.js to sign.
# If unset, a demo key checked into source is used: set your own before showing this to anyone.
# AGENT_SIGNING_KEY=

# --- Ports (defaults shown). Override if something else holds them, e.g. VS Code port forwarding on 3001.
# GATEWAY_PORT=3001
# ADMIN_PORT=3002
# UI_PORT=3005
# The storefront (3003/3004) and the dashboard's admin URL (3002) are fixed.

# --- Agent harness ---
# TRUEFORGE_SERVER_URL=http://localhost:8790
